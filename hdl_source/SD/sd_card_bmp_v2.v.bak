// ============================================================================
// 模块名 : sd_card_bmp_v2.v
// 功能   : 官方 sd_card_bmp 的自有升级版（多图扫描 + 双缓冲切换逻辑保留）
//          改动点：
//            1) 内部 bmp_read 替换为 bmp_read_scaler（支持任意分辨率缩放）
//            2) 新增 auto_period_sel 输入：运行时配置 1/2/3/5 秒轮播周期
//            3) 新增 commit_tgl 输出：每提交一张新图翻转一次，
//               供 video_compose 做淡入淡出转场
// 其余时序/防死锁逻辑与官方完全一致，保证基础功能不变。
// ============================================================================
module sd_card_bmp_v2 #(
    parameter integer CLK_FREQ_HZ       = 100_000_000,
    parameter [31:0]  SCAN_START_SECTOR = 32'd0,
    parameter [31:0]  SCAN_MAX_SECTOR   = 32'd262143,   // 扫描前 128 MB（卡上图片放到 64MB 之后也能找到）
    parameter [3:0]   SCAN_TARGET_COUNT = 4'd8,
    parameter [15:0]  SCAN_GAP_SECTORS  = 16'd16384   // 首轮扫描的"空档容忍"，仿真可调小
)(
    input                       clk,
    input                       rst,
    input                       key_next,
    input                       key_auto,
    input  [1:0]                auto_period_sel,   // 轮播周期档位：0=1s 1=2s 2=3s 3=5s
    output [3:0]                state_code,
    input  [15:0]               bmp_width,
    input  [15:0]               bmp_height,
    output reg                  display_valid,
    output reg                  commit_tgl,      // 新图提交时翻转（转场触发）
    output [3:0]                img_count,      // 已扫描到的合法 BMP 数量（调试用）
    output [2:0]                img_idx_o,      // 当前显示中的图片编号（0 起）
    output                      img_scaled_o,   // 当前图片是否为非 640x480 源图（走了缩放路径）
    output                      scan_lenient_o, // 1 = 走了宽松扫描（接受无工程标记的 BMP）
    output                      auto_on,        // 自动轮播实际状态（调试用）
    output                      load_busy_o,    // 正在加载图片（调试用）
    output                      scan_busy_o,    // 后台还在补充扫描（TF 卡上还有图没认完）

    input                       write_finish_toggle,
    output reg [1:0]            write_buf_idx,
    output reg [1:0]            disp_buf_idx,

    output                      write_req,
    input                       write_req_ack,
    output                      write_en,
    output [31:0]               write_data,
    output                      SD_nCS,
    output                      SD_DCLK,
    output                      SD_MOSI,
    input                       SD_MISO
);

wire key_next_press;
wire key_auto_press;

wire             sd_sec_read;
wire [31:0]      sd_sec_read_addr;
wire [7:0]       sd_sec_read_data;
wire             sd_sec_read_data_valid;
wire             sd_sec_read_end;
wire             bmp_data_wr_en;
wire [23:0]      bmp_data;
wire             sd_init_done;
wire             bmp_ready;
wire             src_scaled;
wire             scan_done;
wire             scan_aborted;
wire             scan_found_valid;
wire [31:0]      scan_found_sector;
wire [3:0]       scan_found_total;
wire [31:0]      scan_resume;

// 后台续扫（追加模式）参数
localparam [31:0] BG_CHUNK    = 32'd2048;        // 每段扫 2048 扇区（1 MB）
localparam [31:0] BG_TICK_MAX = 32'd6_250_000;   // 两段之间至少隔 62.5 ms，别抢 SD 带宽
reg  [31:0]       bg_next;         // 下一段起点
reg               bg_run;          // 本段正在扫
reg               bg_done;         // 整卡扫完 / 已满 8 张
reg  [31:0]       bg_tick;
wire              bg_want = !bg_done && (img_found_count < SCAN_TARGET_COUNT) &&
                            display_valid;

reg  [3:0]        scan_done_d;     // scan_done 稳定计数

reg              scan_start_pulse;
reg              scan_lenient;          // 宽松扫描：接受任意合法 BMP（无工程标记）
reg              load_start_pulse;
reg [31:0]       load_sector;
reg              scan_kicked;
reg              first_image_committed;
reg              auto_play_en;
reg [31:0]       auto_cnt;
localparam integer MAX_IMAGES = 8;     // 最多支持 8 张图（TF 卡里放几张就播几张）

reg [3:0]        img_found_count;
reg [2:0]        img_idx;              // 当前真正显示中的图片编号
reg [2:0]        load_idx;             // 当前正在写入的图片编号
reg              img_scaled;           // 当前图片来源是否非 640x480
reg [1:0]        pending_buf_idx;      // 当前正在写入的目标缓冲区
reg [31:0]       img_sector [0:MAX_IMAGES-1];   // 各图起始扇区表
reg [31:0]       last_scan_sector;               // 上一张命中扇区（去重用，避免动态索引读拉长时序）
reg  [2:0]       next_pend_cnt;       // 待处理的"下一张"请求数（最多 7 个，连按不再丢）
wire             next_req_pending = (next_pend_cnt != 3'd0);
reg              load_busy;
localparam [29:0] LOAD_WD_MAX = 30'd200_000_000;   // 100MHz 下约 2 s（大图读不完就放弃，别让按键久等）
reg  [29:0]       load_wd;
integer          i;
integer          d;
reg              dup_hit;

// 扫描参数选择：首轮用 SCAN_START_SECTOR / 全范围；后台续扫用 bg_next / 分段范围
reg [31:0]       scan_addr_sel;
reg [31:0]       scan_max_sel;
reg              scan_accept_sel;
reg              scan_keep_sel;

// 该扇区是否已在扇区表里（重扫时用来去重）
always @* begin
    dup_hit = 1'b0;
    for (d = 0; d < MAX_IMAGES; d = d + 1)
        if ((d < img_found_count) && (img_sector[d] == scan_found_sector))
            dup_hit = 1'b1;
end

// bmp_ready 先表示“源文件读取/送 FIFO 完成”；真正切显示要等 write_finish_toggle 同步后
reg              source_done_seen;
reg              left_idle;            // 本次加载中 scaler 是否已经离开过 IDLE

// 同步 mem_clk 域的 write_finish_toggle
reg [2:0]        wrfin_tgl_sync;
wire             write_finish_pulse;

wire auto_tick;
wire [2:0] next_from_current;

assign write_en   = bmp_data_wr_en;
assign write_data = {bmp_data[23:16], bmp_data[15:8], bmp_data[7:0], 8'b0};
assign img_count  = img_found_count;
assign img_idx_o  = img_idx;
assign img_scaled_o = img_scaled;
assign scan_lenient_o = scan_lenient;
assign auto_on    = auto_play_en;
assign load_busy_o= load_busy;
assign scan_busy_o= bg_run || (!bg_done && (img_found_count < SCAN_TARGET_COUNT) && display_valid);

function [31:0] period_cycles;
    input [1:0] sel;
    begin
        case (sel)
            2'd0:    period_cycles = CLK_FREQ_HZ;          // 1 s
            2'd1:    period_cycles = CLK_FREQ_HZ * 2;      // 2 s
            2'd2:    period_cycles = CLK_FREQ_HZ * 3;      // 3 s
            default: period_cycles = CLK_FREQ_HZ * 5;      // 5 s
        endcase
    end
endfunction

wire [31:0] auto_period_cycles = period_cycles(auto_period_sel);
assign auto_tick = (auto_cnt >= (auto_period_cycles - 32'd1));
assign next_from_current = next_index_limited(img_idx, img_found_count);
assign write_finish_pulse = wrfin_tgl_sync[2] ^ wrfin_tgl_sync[1];

key_press_debounce #(
    .CLK_FREQ_HZ (CLK_FREQ_HZ),
    .DEBOUNCE_MS (20)
) u_key_next (
    .clk        (clk),
    .rst        (rst),
    .button_in  (key_next),
    .press_pulse(key_next_press)
);

key_press_debounce #(
    .CLK_FREQ_HZ (CLK_FREQ_HZ),
    .DEBOUNCE_MS (20)
) u_key_auto (
    .clk        (clk),
    .rst        (rst),
    .button_in  (key_auto),
    .press_pulse(key_auto_press)
);

function [2:0] next_index_limited;
    input [2:0] cur;
    input [3:0] count;
    reg   [2:0] last;
    begin
        // 注意：count 最大 8，不能写 count[2:0]（8 的低 3 位是 0，会把 last 算错）
        if (count == 4'd0)
            last = 3'd0;
        else
            last = count - 4'd1;
        next_index_limited = (cur >= last) ? 3'd0 : (cur + 3'd1);
    end
endfunction

function [31:0] sector_lut;
    input [2:0] idx;
    begin
        // MAX_IMAGES 是 integer(32bit)，写成 MAX_IMAGES[2:0] 会取到 8 的低 3 位 = 0，
        // 于是 idx < 0 恒不成立、永远返回第 1 张 —— 曾导致"能换图但画面不变"。
        sector_lut = (idx < MAX_IMAGES[3:0]) ? img_sector[idx] : img_sector[0];
    end
endfunction

function [1:0] next_buf_lut;
    input [1:0] cur_disp_buf;
    input       valid_now;
    begin
        if (!valid_now)
            next_buf_lut = 2'd0;                 // 首图固定写 buffer0
        else if (cur_disp_buf == 2'd0)
            next_buf_lut = 2'd1;
        else
            next_buf_lut = 2'd0;
    end
endfunction

always @(posedge clk or posedge rst) begin
    if (rst) begin
        wrfin_tgl_sync        <= 3'b000;
        scan_start_pulse      <= 1'b0;
        load_start_pulse      <= 1'b0;
        load_sector           <= 32'd0;
        scan_kicked           <= 1'b0;
        scan_done_d           <= 4'd0;
        scan_lenient          <= 1'b0;
        first_image_committed <= 1'b0;
        auto_play_en          <= 1'b0;
        auto_cnt              <= 32'd0;
        img_found_count       <= 4'd0;
        img_idx               <= 3'd0;
        load_idx              <= 3'd0;
        pending_buf_idx       <= 2'd0;
        write_buf_idx         <= 2'd0;
        disp_buf_idx          <= 2'd0;
        for (i = 0; i < MAX_IMAGES; i = i + 1)
            img_sector[i] <= 32'd0;
        last_scan_sector <= 32'hFFFF_FFFF;
        next_pend_cnt         <= 3'd0;
        load_busy             <= 1'b0;
        load_wd               <= 30'd0;
        bg_run                <= 1'b0;
        bg_done               <= 1'b0;
        bg_next               <= 32'd0;
        bg_tick               <= 32'd0;
        scan_addr_sel         <= 32'd0;
        scan_max_sel          <= 32'd0;
        scan_accept_sel       <= 1'b0;
        scan_keep_sel         <= 1'b0;
        source_done_seen      <= 1'b0;
        left_idle             <= 1'b0;
        display_valid         <= 1'b0;
        commit_tgl            <= 1'b0;
    end else begin
        wrfin_tgl_sync   <= {wrfin_tgl_sync[1:0], write_finish_toggle};
        scan_start_pulse <= 1'b0;
        load_start_pulse <= 1'b0;

        if (!sd_init_done) begin
            scan_kicked           <= 1'b0;
        scan_done_d           <= 4'd0;
            scan_lenient          <= 1'b0;
            first_image_committed <= 1'b0;
            auto_play_en          <= 1'b0;
            auto_cnt              <= 32'd0;
            img_found_count       <= 4'd0;
            img_idx               <= 3'd0;
            load_idx              <= 3'd0;
            pending_buf_idx       <= 2'd0;
            write_buf_idx         <= 2'd0;
            disp_buf_idx          <= 2'd0;
            for (i = 0; i < MAX_IMAGES; i = i + 1)
                img_sector[i] <= 32'd0;
            last_scan_sector <= 32'hFFFF_FFFF;
            next_pend_cnt         <= 3'd0;
            load_busy             <= 1'b0;
            load_wd               <= 30'd0;
            bg_run                <= 1'b0;
            bg_done               <= 1'b0;
            bg_next               <= 32'd0;
            bg_tick               <= 32'd0;
            source_done_seen      <= 1'b0;
            left_idle             <= 1'b0;
            display_valid         <= 1'b0;
            commit_tgl            <= 1'b0;
        end else begin
            // 扫描阶段缓存前 8 张图的起始 sector；同一扇区重复上报时只记一次，
            // 避免扇区表里出现重复项（否则"下一张"会读到同一张图）。
            // 用 last_scan_sector 寄存器比较，而不是动态索引 img_sector[img_found_count-1]，
            // 避免把存储器读串进组合链里（曾因此把 sd_card_clk 拉到 -0.165ns）。
            if (scan_found_valid && (scan_found_sector != last_scan_sector)) begin
                if (img_found_count < MAX_IMAGES[3:0])
                    img_sector[img_found_count[2:0]] <= scan_found_sector;
                if (img_found_count < MAX_IMAGES[3:0])
                    img_found_count <= img_found_count + 4'd1;
                last_scan_sector <= scan_found_sector;
            end

            // ---------------- 加载看门狗 ----------------
            // 任何一张图（尤其大分辨率缩放图）超过约 5 s 还没写完就放弃本次加载，
            // 否则 load_busy 会永久为 1，按键全部失灵、轮播也停摆。
            if (load_busy) begin
                if (load_wd == LOAD_WD_MAX) begin
                    load_busy        <= 1'b0;
                    load_wd          <= 30'd0;
                    source_done_seen <= 1'b0;
                    left_idle        <= 1'b0;
                end else begin
                    load_wd <= load_wd + 30'd1;
                end
            end else begin
                load_wd <= 30'd0;
            end

            // 记录 scaler 是否已把源图送完（仅用于调试观察，不再参与提交判定）
            if (load_busy && bmp_ready && left_idle)
                source_done_seen <= 1'b1;
            if (load_busy && !bmp_ready)
                left_idle <= 1'b1;

            // 只有真正收到 write_finish_toggle 脉冲，才提交新图并切换显示缓冲区。
            // write_finish 表示 307200 个像素已经全部写进 SDRAM，此时提交是安全的，
            // 不再额外等待 scaler 回到 IDLE（两者时序先后并不固定）。
            if (load_busy && write_finish_pulse) begin
                load_busy             <= 1'b0;
                source_done_seen      <= 1'b0;
                left_idle             <= 1'b0;
                disp_buf_idx          <= pending_buf_idx;
                img_idx               <= load_idx;
                img_scaled            <= src_scaled;
                display_valid         <= 1'b1;
                first_image_committed <= 1'b1;
                commit_tgl            <= ~commit_tgl;   // 通知合成层：开始转场
            end

            // ================= 上电首轮扫描（快速出图） =================
            if (!scan_kicked && bmp_ready) begin
                scan_start_pulse      <= 1'b1;
                scan_kicked           <= 1'b1;
                scan_accept_sel       <= 1'b0;      // 首轮只认带 HX4S 标记的图
                scan_keep_sel         <= 1'b0;
                scan_addr_sel         <= SCAN_START_SECTOR;
                scan_max_sel          <= SCAN_MAX_SECTOR;
                first_image_committed <= 1'b0;
                auto_play_en          <= 1'b0;
                auto_cnt              <= 32'd0;
                img_found_count       <= 4'd0;
                last_scan_sector      <= 32'hFFFF_FFFF;
                img_idx               <= 3'd0;
                load_idx              <= 3'd0;
                img_scaled            <= 1'b0;
                pending_buf_idx       <= 2'd0;
                write_buf_idx         <= 2'd0;
                disp_buf_idx          <= 2'd0;
                next_pend_cnt         <= 3'd0;
                display_valid         <= 1'b0;
                load_busy             <= 1'b0;
                bg_run                <= 1'b0;
                bg_done               <= 1'b0;
                bg_next               <= 32'd0;
                bg_tick               <= 32'd0;
                source_done_seen      <= 1'b0;
                left_idle             <= 1'b0;
            end else begin
                // scan_done 稳定 8 拍，保证最后一次 scan_found_valid 已计入 img_found_count
                if (scan_done) begin
                    if (scan_done_d != 4'd8)
                        scan_done_d <= scan_done_d + 4'd1;
                end else begin
                    scan_done_d <= 4'd0;
                end

                // ================= 后台续扫（追加模式，分段） =================
                // 首轮扫描为了快速出图只扫有限范围；之后在后台一小段一小段往后扫，
                // 每找到一张就追加进扇区表（去重），最多补到 8 张。
                // 这样不管卡上 8 个文件排得多散、有没有 HX4S 标记，最终都能全部认出来。
                if (bg_tick != BG_TICK_MAX)
                    bg_tick <= bg_tick + 32'd1;

                if (bg_run && scan_done) begin
                    bg_run  <= 1'b0;
                    bg_next <= scan_resume;
                    bg_tick <= 32'd0;
                    // 已经找到 8 张，或扫到卡尾，或这一段没有任何前进 → 停止后台扫描
                    if ((img_found_count >= SCAN_TARGET_COUNT) ||
                        (scan_resume >= SCAN_MAX_SECTOR) ||
                        (scan_resume == bg_next))
                        bg_done <= 1'b1;
                end else if ((scan_done_d == 4'd8) && bg_want && bmp_ready && !load_busy &&
                             !next_req_pending && !scan_start_pulse && (bg_tick >= BG_TICK_MAX)) begin
                    scan_start_pulse <= 1'b1;
                    bg_run           <= 1'b1;
                    scan_accept_sel  <= 1'b1;      // 宽松：任意合法 BMP 都收（补漏）
                    scan_keep_sel    <= 1'b1;      // 追加，不清零已找到的张数
                    scan_addr_sel    <= bg_next;
                    scan_max_sel     <= (bg_next + BG_CHUNK > SCAN_MAX_SECTOR)
                                        ? SCAN_MAX_SECTOR : (bg_next + BG_CHUNK);
                    bg_tick          <= 32'd0;
                end

                // ================= 按键 / 轮播请求 =================
                // 手动"下一张"：最多缓存 7 个，连按不会丢
                if (key_next_press && (next_pend_cnt != 3'd7))
                    next_pend_cnt <= next_pend_cnt + 3'd1;

                // 自动轮播开关
                if (key_auto_press) begin
                    auto_play_en <= ~auto_play_en;
                    auto_cnt     <= 32'd0;
                end

                // 自动轮播计时：不因加载而清零，保证周期就是用户设定的周期
                if (auto_play_en && display_valid && first_image_committed && (img_found_count > 4'd1)) begin
                    if (auto_tick)
                        auto_cnt <= 32'd0;
                    else
                        auto_cnt <= auto_cnt + 32'd1;
                end else begin
                    auto_cnt <= 32'd0;
                end

                // 自动轮播到点 → 也投递一个"下一张"请求，走完全相同的加载通路。
                // 这样手动/自动只有一条路径，不会出现"手动能换、自动不换"的分叉。
                if (auto_play_en && auto_tick && display_valid && (img_found_count > 4'd1) &&
                    !load_busy && (next_pend_cnt == 3'd0))
                    next_pend_cnt <= 3'd1;

                // ================= 首图加载（写 buffer0） =================
                if ((scan_done_d == 4'd8) && !first_image_committed && bmp_ready && !load_busy &&
                    (img_found_count != 4'd0)) begin
                    load_idx         <= 3'd0;
                    load_sector      <= img_sector[0];
                    pending_buf_idx  <= 2'd0;
                    write_buf_idx    <= 2'd0;
                    load_start_pulse <= 1'b1;
                    load_busy        <= 1'b1;
                    source_done_seen <= 1'b0;
                    left_idle        <= 1'b0;
                    next_pend_cnt    <= 3'd0;
                    auto_cnt         <= 32'd0;
                end
                // ================= 下一张（手动/自动共用） =================
                // 不再要求 scan_done：只要 scaler 空闲就能加载，后台扫描不会把按键挡住
                else if (bmp_ready && display_valid && !load_busy && next_req_pending &&
                         (img_found_count != 4'd0)) begin
                    load_idx         <= next_from_current;
                    load_sector      <= sector_lut(next_from_current);
                    pending_buf_idx  <= next_buf_lut(disp_buf_idx, display_valid);
                    write_buf_idx    <= next_buf_lut(disp_buf_idx, display_valid);
                    load_start_pulse <= 1'b1;
                    load_busy        <= 1'b1;
                    source_done_seen <= 1'b0;
                    left_idle        <= 1'b0;
                    next_pend_cnt    <= next_pend_cnt - 3'd1;
                    auto_cnt         <= 32'd0;
                end
            end
        end
    end
end

bmp_read_scaler #(
    .SCAN_GAP (SCAN_GAP_SECTORS)
) bmp_read_m0(
    .clk                    (clk),
    .rst                    (rst),
    .ready                  (bmp_ready),

    .scan_start             (scan_start_pulse),
    .scan_start_sector      (scan_addr_sel),
    .scan_max_sector        (scan_max_sel),
    .scan_target_count      (SCAN_TARGET_COUNT),
    .scan_accept_any        (scan_accept_sel),
    .scan_keep              (scan_keep_sel),
    .scan_done              (scan_done),
    .scan_aborted           (scan_aborted),
    .scan_found_valid       (scan_found_valid),
    .scan_found_sector      (scan_found_sector),
    .scan_found_total       (scan_found_total),
    .scan_resume            (scan_resume),

    .load_start             (load_start_pulse),
    .load_sector            (load_sector),

    .sd_init_done           (sd_init_done),
    .state_code             (state_code),
    .scaled_o               (src_scaled),
    .bmp_width              (bmp_width),
    .bmp_height             (bmp_height),
    .write_req              (write_req),
    .write_req_ack          (write_req_ack),
    .sd_sec_read            (sd_sec_read),
    .sd_sec_read_addr       (sd_sec_read_addr),
    .sd_sec_read_data       (sd_sec_read_data),
    .sd_sec_read_data_valid (sd_sec_read_data_valid),
    .sd_sec_read_end        (sd_sec_read_end),
    .bmp_data_wr_en         (bmp_data_wr_en),
    .bmp_data               (bmp_data)
);

sd_card_top sd_card_top_m0(
    .clk                    (clk),
    .rst                    (rst),
    .SD_nCS                 (SD_nCS),
    .SD_DCLK                (SD_DCLK),
    .SD_MOSI                (SD_MOSI),
    .SD_MISO                (SD_MISO),
    .sd_init_done           (sd_init_done),
    .sd_sec_read            (sd_sec_read),
    .sd_sec_read_addr       (sd_sec_read_addr),
    .sd_sec_read_data       (sd_sec_read_data),
    .sd_sec_read_data_valid (sd_sec_read_data_valid),
    .sd_sec_read_end        (sd_sec_read_end),
    .sd_sec_write           (1'b0),
    .sd_sec_write_addr      (32'd0),
    .sd_sec_write_data      (),
    .sd_sec_write_data_req  (),
    .sd_sec_write_end       ()
);

endmodule

module key_press_debounce #(
    parameter integer CLK_FREQ_HZ = 100_000_000,
    parameter integer DEBOUNCE_MS = 20
)(
    input  wire clk,
    input  wire rst,
    input  wire button_in,    // 默认：松开=1，按下=0
    output reg  press_pulse
);

localparam integer DEBOUNCE_CYCLES = (CLK_FREQ_HZ / 1000) * DEBOUNCE_MS;

reg button_sync0;
reg button_sync1;
reg button_stable;
reg [31:0] cnt;

always @(posedge clk or posedge rst) begin
    if (rst) begin
        button_sync0  <= 1'b1;
        button_sync1  <= 1'b1;
        button_stable <= 1'b1;
        cnt           <= 32'd0;
        press_pulse   <= 1'b0;
    end else begin
        button_sync0 <= button_in;
        button_sync1 <= button_sync0;
        press_pulse  <= 1'b0;

        if (button_sync1 == button_stable) begin
            cnt <= 32'd0;
        end else begin
            if (cnt >= DEBOUNCE_CYCLES - 1) begin
                if (button_stable && !button_sync1)
                    press_pulse <= 1'b1;
                button_stable <= button_sync1;
                cnt           <= 32'd0;
            end else begin
                cnt <= cnt + 32'd1;
            end
        end
    end
end

endmodule
